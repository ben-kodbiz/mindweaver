# MindWeaver configuration example.
# Copy to `.env` and adjust. Nested keys use `__` as separator.
# The `MINDWEAVER_` prefix maps to the `Settings` model in services/api.

# APP
MINDWEAVER_APP__ENVIRONMENT=development
MINDWEAVER_HARDWARE_PROFILE=medium
MINDWEAVER_APP__DEBUG=false
MINDWEAVER_APP__LOG_LEVEL=INFO

# DATABASE
MINDWEAVER_DATABASE__URL=sqlite:///./data/mindweaver.db
MINDWEAVER_DATABASE__ECHO=false

# STORAGE
MINDWEAVER_STORAGE__ROOT_DIR=./data
MINDWEAVER_STORAGE__ORIGINALS_DIR=./data/originals
MINDWEAVER_STORAGE__DERIVED_DIR=./data/derived
MINDWEAVER_STORAGE__MAX_UPLOAD_BYTES=524288000

# LLM
# provider: ollama | llamacpp | lmstudio | openai-compatible (all OpenAI-compatible) | stub (offline/test)
MINDWEAVER_LLM__PROVIDER=ollama
MINDWEAVER_LLM__BASE_URL=http://localhost:11434
MINDWEAVER_LLM__MODEL=
MINDWEAVER_LLM__TIMEOUT_SECONDS=300
MINDWEAVER_LLM__TEMPERATURE=0.2
# Optional JSON merged into every chat-completions request (server-specific
# knobs). Example for Qwen "thinking" models on LM Studio — disables reasoning
# so answers land in `content` instead of exhausting max_tokens:
# MINDWEAVER_LLM__EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# CHAT
MINDWEAVER_CHAT__EVIDENCE_LIMIT=5
MINDWEAVER_CHAT__MAX_TOKENS=512

# GRAPH
MINDWEAVER_GRAPH__MAX_CHUNKS=40
MINDWEAVER_GRAPH__MAX_NODES=100
MINDWEAVER_GRAPH__MAX_TOKENS=1024

# MINDMAP
MINDWEAVER_MINDMAP__MAX_TOPICS=8
MINDWEAVER_MINDMAP__MAX_CONCEPTS_PER_TOPIC=3
MINDWEAVER_MINDMAP__MAX_DEPTH=2

# EMBEDDINGS
# provider: local (fast, deterministic, no model download) | sentence-transformers (needs [embeddings] extra)
MINDWEAVER_EMBEDDINGS__PROVIDER=local
MINDWEAVER_EMBEDDINGS__MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MINDWEAVER_EMBEDDINGS__DIMENSION=512

# RERANKER
MINDWEAVER_RERANKER__PROVIDER=local
MINDWEAVER_RERANKER__MODEL=
MINDWEAVER_RERANKER__ENABLED=true

# SEARCH
MINDWEAVER_SEARCH__FTS_WEIGHT=0.4
MINDWEAVER_SEARCH__VECTOR_WEIGHT=0.6
MINDWEAVER_SEARCH__MIN_SCORE=0.05

# OCR
MINDWEAVER_OCR__PROVIDER=rapidocr
MINDWEAVER_OCR__LANGUAGES=["en"]
MINDWEAVER_OCR__MIN_CONFIDENCE=0.5
MINDWEAVER_OCR__RENDER_SCALE=2.5

# DOCUMENT_PROCESSOR
# backend: pypdf (default, no extra deps) | docling (requires the [docling] extra)
MINDWEAVER_DOCUMENT_PROCESSOR__BACKEND=pypdf
MINDWEAVER_DOCUMENT_PROCESSOR__OCR_ENABLED=true

# CHUNKING
MINDWEAVER_CHUNKING__MAX_CHARS=2000
MINDWEAVER_CHUNKING__MIN_CHARS=100

# TTS
MINDWEAVER_TTS__PROVIDER=kokoro

# WORKER
MINDWEAVER_WORKER__CONCURRENCY=2

# SECURITY
MINDWEAVER_SECURITY__SECRET_KEY=change-me
MINDWEAVER_SECURITY__CORS_ORIGINS=["http://localhost:5173"]

# --- Optional Vision + Tool-Calling Intelligence Layer (feature01) ---
# Disabled by default. Enable only if you run a local OpenAI-compatible server.
# Shorthand env vars (MW_*) also work for the most common settings.
MINDWEAVER_INTELLIGENCE__ENABLED=false

# TEXT MODEL — used for node expansion, structured extraction, tool-calling.
# preset: lmstudio-local | llamacpp-local | (blank for manual config)
MINDWEAVER_INTELLIGENCE__TEXT__ENABLED=false
MINDWEAVER_INTELLIGENCE__TEXT__PRESET=
MINDWEAVER_INTELLIGENCE__TEXT__BASE_URL=http://localhost:1234/v1
MINDWEAVER_INTELLIGENCE__TEXT__MODEL=
MINDWEAVER_INTELLIGENCE__TEXT__CAPABILITIES__CHAT=true
MINDWEAVER_INTELLIGENCE__TEXT__CAPABILITIES__TOOL_CALLING=true
MINDWEAVER_INTELLIGENCE__TEXT__CAPABILITIES__STRUCTURED_OUTPUT=true

# VISION MODEL — used for diagram/table/chart analysis on low-OCR pages.
MINDWEAVER_INTELLIGENCE__VISION__ENABLED=false
MINDWEAVER_INTELLIGENCE__VISION__BASE_URL=http://localhost:1234/v1
MINDWEAVER_INTELLIGENCE__VISION__MODEL=
MINDWEAVER_INTELLIGENCE__VISION__CAPABILITIES__VISION=true

# TOOL LOOP — bounds the agent loop during expansion.
MINDWEAVER_INTELLIGENCE__TOOLS__ENABLED=false
MINDWEAVER_INTELLIGENCE__TOOLS__MAX_ITERATIONS=5
MINDWEAVER_INTELLIGENCE__TOOLS__MAX_TOOL_CALLS=10
MINDWEAVER_INTELLIGENCE__TOOLS__TIMEOUT_SECONDS=30.0

# VISION ANALYSIS — page selection triggers for vision model.
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__ENABLED=false
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__ANALYZE_ALL_PAGES=false
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__CONFIDENCE_THRESHOLD=0.70
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__TRIGGERS__LOW_OCR_CONFIDENCE=true
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__TRIGGERS__COMPLEX_LAYOUT=true
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__TRIGGERS__TABLES=true
MINDWEAVER_INTELLIGENCE__VISION_ANALYSIS__TRIGGERS__DIAGRAMS=true

# NODE EXPANSION — AI-powered child node proposals.
MINDWEAVER_INTELLIGENCE__NODE_EXPANSION__ENABLED=false
MINDWEAVER_INTELLIGENCE__NODE_EXPANSION__REQUIRE_EVIDENCE=true
MINDWEAVER_INTELLIGENCE__NODE_EXPANSION__MAX_CHILDREN=8

# --- Shorthand overrides (lower priority than MINDWEAVER_ prefixed vars) ---
# MW_INTELLIGENCE_ENABLED=true
# MW_TEXT_MODEL_ENABLED=true
# MW_TEXT_MODEL_BASE_URL=http://localhost:1234/v1
# MW_TEXT_MODEL_NAME=my-model
# MW_VISION_MODEL_ENABLED=true
# MW_VISION_MODEL_BASE_URL=http://localhost:1234/v1
# MW_VISION_MODEL_NAME=my-vision-model
# MW_TOOLS_ENABLED=true
# MW_VISION_ENABLED=true
